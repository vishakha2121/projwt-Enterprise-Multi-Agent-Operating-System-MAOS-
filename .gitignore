!.env.example

# ---- Database ----
*.db
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/chroma_db/

# ---- Logs ----
*.log
logs/
backend/data/logs/*.log
backend/data/logs/*.txt

# ---- Node / Frontend ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
